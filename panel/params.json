    { "id": 27, "key": "shake",             "module": "damage", "label": "Line Shake",              "type": "float",    "min": 0,     "max": 1,    "default": 0.3,     "keyframe": true },
    { "id": 28, "key": "tear",              "module": "damage", "label": "Sync Tear",               "type": "float",    "min": 0,     "max": 1,    "default": 0.2,     "keyframe": true },
    { "id": 29, "key": "roll",              "module": "damage", "label": "Vertical Roll",           "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": true },
