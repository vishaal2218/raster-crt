    { "id": 51, "key": "mask_type",         "module": "screen", "label": "Mask Type",               "type": "popup",    "options": ["Slot Mask", "Aperture Grille", "Delta Dot", "Fine Slot Mask", "Square Grid"], "default": 0, "keyframe": false },
    { "id": 52, "key": "mask_scale",        "module": "screen", "label": "Mask Scale",              "type": "float",    "min": 0,     "max": 1,    "default": 0.4,   "keyframe": true },
