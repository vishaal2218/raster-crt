    { "id": 64, "key": "pulse_contrast",    "module": "capture","label": "Scan Pulse",              "type": "float",    "min": 0,     "max": 2,    "default": 1.0,     "keyframe": true, "note": "capture is engaged when capture_master x pulse_contrast > 0" },
    { "id": 65, "key": "band_angle",        "module": "capture","label": "Band Angle",              "type": "angle",    "min": -90,   "max": 90,   "default": 0,     "keyframe": true },
    { "id": 66, "key": "sensor_readout",    "module": "capture","label": "Sensor Readout",          "type": "float",    "min": 0,     "max": 1.5,  "default": 1,     "keyframe": true },
    { "id": 67, "key": "moire",             "module": "capture","label": "Moiré",                   "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": true },
    { "id": 68, "key": "rainbow",           "module": "capture","label": "Rainbow Interference",    "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": true },

    { "id": 69, "key": "convergence_master","module": "convergence", "label": "Convergence Amount", "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": false, "master": true },
    { "id": 70, "key": "beam_convergence",  "module": "convergence", "label": "Beam Misalignment",  "type": "float",    "min": 0,     "max": 1,    "default": 0.4,   "keyframe": true },
    { "id": 71, "key": "convergence_angle", "module": "convergence", "label": "Misalignment Angle", "type": "angle",    "min": 0,     "max": 360,  "default": 45,    "keyframe": true, "depends_on": "beam_convergence > 0" },
    { "id": 72, "key": "phosphor_convergence","module": "convergence","label": "Phosphor Misalignment","type": "float", "min": 0,     "max": 1,    "default": 0,     "keyframe": true },

    { "id": 73, "key": "glass_master",      "module": "glass",  "label": "Glass & Optics Amount",   "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": false, "master": true },
    { "id": 74, "key": "glow",              "module": "glass",  "label": "Glow",                    "type": "float",    "min": 0,     "max": 1,    "default": 0.2,   "keyframe": true },
    { "id": 75, "key": "spectral_bloom",    "module": "glass",  "label": "Spectral Bloom",          "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": true },
    { "id": 76, "key": "glass_curve",       "module": "glass",  "label": "Glass Curve",             "type": "float",    "min": 0,     "max": 1,    "default": 0.2,   "keyframe": true },
    { "id": 77, "key": "line_stretch",      "module": "glass",  "label": "Line Stretch",            "type": "float",    "min": -1,    "max": 1,    "default": 0,     "keyframe": true },
    { "id": 78, "key": "fisheye",           "module": "glass",  "label": "Fisheye",                 "type": "float",    "min": -1,    "max": 2,    "default": 0,     "keyframe": true },
    { "id": 79, "key": "outside",           "module": "glass",  "label": "Outside Screen",          "type": "popup",    "options": ["Opaque", "Transparent"], "default": 0, "keyframe": false },
    { "id": 80, "key": "extend_edges",      "module": "glass",  "label": "Extend Edges",            "type": "checkbox", "default": false, "keyframe": false }
