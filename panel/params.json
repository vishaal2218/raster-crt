{
  "format": "raster-crt-params/1",
  "rule": "ids are permanent. Never reorder, renumber or reuse an id once a build has shipped; only append. Premiere stores clip values by id.",
  "modules": [
    { "key": "global",       "label": "Global",         "section": "service" },
    { "key": "colour",       "label": "Colour Signal",  "section": "signal" },
    { "key": "bend",         "label": "Circuit Bend",   "section": "signal" },
    { "key": "damage",       "label": "Damage",         "section": "signal" },
    { "key": "noise",        "label": "Noise",          "section": "signal" },
    { "key": "waves",        "label": "Waves",          "section": "signal" },
    { "key": "screen",       "label": "Screen",         "section": "screen" },
    { "key": "capture",      "label": "Capture",        "section": "screen" },
    { "key": "convergence",  "label": "Convergence",    "section": "screen" },
    { "key": "glass",        "label": "Glass & Optics", "section": "screen" }
  ],
  "params": [
    { "id": 1,  "key": "preset",            "module": "global", "label": "Preset",                  "type": "popup",    "options": "factory presets from presets/factory.json, first entry 'Custom'", "default": 0, "keyframe": false },
    { "id": 2,  "key": "mix",               "module": "global", "label": "Dry/Wet",                 "type": "float",    "min": 0,     "max": 1,    "default": 1,     "keyframe": true },
    { "id": 3,  "key": "brightness",        "module": "global", "label": "Brightness",              "type": "float",    "min": -0.25, "max": 0.25, "default": 0,     "keyframe": true },
    { "id": 4,  "key": "contrast",          "module": "global", "label": "Contrast",                "type": "float",    "min": 0.5,   "max": 2.5,  "default": 1,     "keyframe": true },
    { "id": 5,  "key": "clean_signal",      "module": "global", "label": "Clean Signal",            "type": "float",    "min": 0,     "max": 1,    "default": 0.3,   "keyframe": true },
    { "id": 6,  "key": "quality",           "module": "global", "label": "Quality",                 "type": "popup",    "options": ["SD", "HI", "FULL"], "default": 1, "keyframe": false, "note": "processing raster: SD 480 lines, HI 720 lines, FULL source size. Changes the look, not the output size" },

    { "id": 7,  "key": "colour_master",     "module": "colour", "label": "Colour Signal Amount",    "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": false, "master": true },
    { "id": 8,  "key": "gain",              "module": "colour", "label": "Signal Gain",             "type": "float",    "min": 0.4,   "max": 2,    "default": 1,     "keyframe": true },
    { "id": 9,  "key": "chroma_level",      "module": "colour", "label": "Chroma Level",            "type": "float",    "min": 0,     "max": 2.5,  "default": 1,     "keyframe": true },
    { "id": 10, "key": "hue_drift",         "module": "colour", "label": "Hue Drift",               "type": "float",    "min": 0,     "max": 1.2,  "default": 0.1,   "keyframe": true },
    { "id": 11, "key": "chroma_bleed",      "module": "colour", "label": "Chroma Bleed",            "type": "float",    "min": 0,     "max": 1,    "default": 0.3,   "keyframe": true },
    { "id": 12, "key": "rgb_split",         "module": "colour", "label": "RGB Split",               "type": "float",    "min": 0,     "max": 1,    "default": 0.1,   "keyframe": true },
