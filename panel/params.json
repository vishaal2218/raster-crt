    { "id": 59, "key": "beam_softness",     "module": "screen", "label": "Beam Softness",           "type": "float",    "min": 0,     "max": 1,    "default": 0.3,   "keyframe": true },
    { "id": 60, "key": "phosphor_bloom",    "module": "screen", "label": "Phosphor Bloom",          "type": "float",    "min": 0,     "max": 1,    "default": 0.2,   "keyframe": true },
    { "id": 61, "key": "overscan",          "module": "screen", "label": "Overscan",                "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": true },

    { "id": 62, "key": "capture_master",    "module": "capture","label": "Capture Amount",          "type": "float",    "min": 0,     "max": 1,    "default": 0,     "keyframe": false, "master": true },
